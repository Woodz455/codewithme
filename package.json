{
  "name": "codewithme",
  "version": "1.0.0",
  "description": "CodeWithMe — apprends a coder en Python, HTML, CSS, JavaScript et C++ / Learn to code in Python, HTML, CSS, JavaScript and C++",
  "author": "CodeWithMe",
  "license": "MIT",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "vendor": "node tools/vendor.mjs",
    "start": "electron .",
    "dev": "electron . --dev",
    "check:content": "xvfb-run -a node tools/check-content.mjs",
    "check:contrast": "node tools/check-contrast.mjs",
    "test": "npm run check:icones && npm run test:python && npm run test:moteurs && npm run test:apercu && npm run test:atelier && npm run test:espaces",
    "test:python": "xvfb-run -a node tests/verifier-python.mjs",
    "test:moteurs": "xvfb-run -a node tests/verifier-moteurs-web-cpp.mjs",
    "test:atelier": "xvfb-run -a node tests/verifier-atelier.mjs",
    "captures": "xvfb-run -a node tests/capture.mjs && xvfb-run -a node tests/capture-atelier.mjs",
    "build:win": "electron-builder --win --publish never",
    "check:icones": "node tools/check-icones.mjs",
    "test:espaces": "xvfb-run -a node tests/verifier-espaces.mjs",
    "test:apercu": "xvfb-run -a node tests/verifier-apercu.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "devicon": "^2.17.0",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "lucide-static": "^1.34.0",
    "playwright": "^1.62.1"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "codemirror": "5.65.21",
    "JSCPP": "2.0.9",
    "pyodide": "314.0.5"
  }
}
